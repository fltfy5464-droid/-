
   
# Deadline Monotonic (DM) Scheduling with Semaphore
# Discrete-time, preemptive simulation

tasks = [
    {"name": "P1", "arrival": 0, "deadline": 7,
     "before": 1, "critical": 2, "after": 2},

    {"name": "P2", "arrival": 1, "deadline": 4,
     "before": 1, "critical": 1, "after": 1},

    {"name": "P3", "arrival": 2, "deadline": 6,
     "before": 1, "critical": 1, "after": 1},
]

# Each task's execution time = before + critical + after.
# Shorter relative deadline means higher DM priority.

for p in tasks:
    p["burst"] = p["before"] + p["critical"] + p["after"]
    p["remaining_before"] = p["before"]
    p["remaining_cs"] = p["critical"]
    p["remaining_after"] = p["after"]
    p["phase"] = "BEFORE"
    p["first_start"] = None
    p["completion"] = None
    p["wait"] = 0
    p["blocked"] = 0
    p["done"] = False

    if p["remaining_before"] == 0:
        p["phase"] = "CS"

semaphore_owner = None
gantt = []
time = 0
idle_time = 0


def normalize(p):
    """Skip execution phases that have zero duration."""
    if p["phase"] == "BEFORE" and p["remaining_before"] == 0:
        p["phase"] = "CS"

    if p["phase"] == "CS" and p["remaining_cs"] == 0:
        p["phase"] = "AFTER"

    if p["phase"] == "AFTER" and p["remaining_after"] == 0:
        p["phase"] = "DONE"
        p["done"] = True


def record_gantt(start, end, label):
    if gantt and gantt[-1][2] == label:
        gantt[-1] = (gantt[-1][0], end, label)
    else:
        gantt.append((start, end, label))


# Discrete-time scheduling loop
while any(not p["done"] for p in tasks):
    for p in tasks:
        normalize(p)

    ready = [
        p for p in tasks
        if p["arrival"] <= time and not p["done"]
    ]

    blocked_now = [
        p for p in ready
        if p["phase"] == "CS"
        and semaphore_owner is not None
        and semaphore_owner != p["name"]
    ]

    runnable = [p for p in ready if p not in blocked_now]

    # Count time spent blocked by the semaphore.
    for p in blocked_now:
        p["blocked"] += 1

    # DM priority: earliest relative deadline first.
    runnable.sort(key=lambda p: p["deadline"])

    if not runnable:
        idle_time += 1
        record_gantt(time, time + 1, "IDLE")
        time += 1
        continue

    current = runnable[0]

    # Other runnable jobs wait in the ready queue.
    for p in runnable[1:]:
        p["wait"] += 1

    if current["first_start"] is None:
        current["first_start"] = time

    # Acquire semaphore when entering the critical section.
    if current["phase"] == "CS" and semaphore_owner is None:
        semaphore_owner = current["name"]
        print(f"t={time}: {current['name']} acquired semaphore")

    record_gantt(time, time + 1, current["name"])

    # Execute one time unit.
    if current["phase"] == "BEFORE":
        current["remaining_before"] -= 1

    elif current["phase"] == "CS":
        current["remaining_cs"] -= 1

        # Release semaphore after critical section finishes.
        if current["remaining_cs"] == 0:
            semaphore_owner = None
            print(f"t={time + 1}: {current['name']} released semaphore")
            current["phase"] = "AFTER"

    elif current["phase"] == "AFTER":
        current["remaining_after"] -= 1

    time += 1

    normalize(current)

    if current["done"]:
        current["completion"] = time


# Results
print("\nDM Scheduling with Semaphore")
print("=" * 85)

print(
    f"{'Task':<7}{'Deadline':<10}{'Burst':<8}"
    f"{'Response':<10}{'Wait':<8}{'Result':<9}{'Blocked':<9}"
)

for p in sorted(tasks, key=lambda x: x["name"]):
    response_time = p["first_start"] - p["arrival"]
    result_time = p["completion"] - p["arrival"]

    print(
        f"{p['name']:<7}{p['deadline']:<10}{p['burst']:<8}"
        f"{response_time:<10}{p['wait']:<8}"
        f"{result_time:<9}{p['blocked']:<9}"
    )

print("\nGantt Chart:")
for start, end, label in gantt:
    print(f"| {label} [{start}-{end}] ", end="")
print("|")

print(f"\nTotal CPU Idle Time = {idle_time}")

print("\nAverage metrics:")
n = len(tasks)
print("Average Response Time =",
      sum(p["first_start"] - p["arrival"] for p in tasks) / n)
print("Average Wait Time =",
      sum(p["wait"] for p in tasks) / n)
print("Average Turnaround Time =",
      sum(p["completion"] - p["arrival"] for p in tasks) / n)
print("Total Blocked Time =",
      sum(p["blocked"] for p in tasks))